# Base URL of the PlacementIQ backend API.
# In docker-compose this is set to the backend service; for local dev
# outside Docker the default (http://localhost:8000) is used when unset.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase (optional — used by src/lib/supabase.ts if auth is enabled).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
